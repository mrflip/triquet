# dependencies
node_modules/

# scratch space -- the top-level directory is kept, its contents are not
**/tmp/*
**/temp/*

# Various turds some utilities leave behind
*.pid
*.pid.lock
*.seed
*.lcov
.node_repl_history

# editors
*.swp
*.swo
*~
\#*\#
.#*
.idea/
.vscode/*
!.vscode/extensions.json

# OS generated files
.DS_Store
._*
Thumbs.db
ehthumbs.db
.Spotlight-V100
.Trashes

# next.js
.next/
.next-*/
.next-agent-build/
out/

# production
build/

# testing / coverage
coverage/

# misc
*.tsbuildinfo
.eslintcache

# vercel -- written by `vercel link`
.vercel

# env files -- never commit secrets; use Doppler
.env*
!.env*.template

# secrets -- anything that names itself a secret stays out, unless it is a template
*secret*
!*secret*template*
!*template*secret*
*.pem

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# typescript
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/blob-report/
/.playwright/

# dist/

# local databases -- the directory is kept, its contents are not
/data/*
!/data/.gitkeep
