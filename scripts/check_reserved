#!/usr/bin/env bash
# The guard to run before the reserved list grows: reads every userlabel, ghosting and hunt label
# the deployment holds, and names each the list of this checkout keeps. A userlabel is held to the
# whole list always, so deploy a grown list only once this names no holder. Read-only, behind the
# janitor's guard, which names the deployment it reached. See scripts/check-reserved.ts, and
# notes/deploy.md, *Checking the reserved list against production*.
#
#   ./scripts/doppledo prd_janitor scripts/check_reserved
#
# Usage: scripts/check_reserved [--deployment <name>]
set -euo pipefail
cd "$(dirname "$0")/.."
exec node_modules/.bin/tsx scripts/check-reserved.ts "$@"
