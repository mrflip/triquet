#!/usr/bin/env bash
# Deletes every person from a deployment and keeps its hunts: a dry run unless told, by
# --deployment, the deployment it reaches. See scripts/clear-people.ts, and notes/deploy.md,
# *Clearing production's people*.
#
#   ./scripts/doppledo prd_janitor scripts/clear_people                          a dry run: count, and say where it is aimed
#   ./scripts/doppledo prd_janitor scripts/clear_people --deployment <its name>  delete
#
# Usage: scripts/clear_people [--deployment <name>]
set -euo pipefail
cd "$(dirname "$0")/.."
exec node scripts/clear-people.ts "$@"
