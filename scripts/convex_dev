#!/usr/bin/env bash
# Runs a command against one role's own local Convex backend, with the app's functions pushed to
# it: `pnpm dev:agent` runs the agents' Next dev server this way, and the e2e suite its own.
#
#   1. Starts the role's backend (scripts/convex_backend) unless it is already answering, logging
#      to data/convex-<role>/backend.log, and stops it again on the way out. One already running,
#      someone else's or your own, is used and left alone.
#   2. Gives it Google's keys for signing in with Google (AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET) from
#      the Doppler config this runs under, or takes them away where that config has none, so the
#      backend offers Google exactly when its config does (convex/auth.ts). Pushes convex/ to it
#      (regenerating convex/_generated/), marks it clearable (TRIQUET_CLEARABLE=yes, which
#      testing:clearAll asks for), and gives it Convex Auth's keys when it has none
#      (scripts/convex_auth_keys).
#   3. With --reset, empties it (scripts/convex_reset). A push that a schema change refuses, for
#      rows the new schema no longer fits, is then retried once the backend is empty. One refused
#      without --reset says how to catch the backend up instead (scripts/deploy.ts --role).
#   4. Records the checkout's HEAD in the backend's migrations table as the step it was pushed
#      (deploying:recordPushed; notes/deploy.md, *The two modes*) and starts its backfills
#      (migrations:runAll), without waiting for them.
#   5. With --seed, seeds it (seeding:seedWidgets, which is safe to run again): the library's seed
#      widgets, and the default widgetings for a quiz laid out before there were any. A deploy
#      seeds production the same way.
#   6. With --watch, keeps pushing convex/ as it changes, for as long as the command runs.
#   7. Runs the command with NEXT_PUBLIC_CONVEX_URL naming the backend, and PORT the role's web
#      port: both as scripts/lanes.ts has them for this checkout's lane.
#
# Usage: scripts/convex_dev <dev|agent|e2e|e2e-agent|e2e-built> [--reset] [--seed] [--watch] <command> [arguments...]
#   eg   scripts/doppledo dev_claude scripts/convex_dev agent --watch next dev
set -euo pipefail
cd "$(dirname "$0")/.."

usage="Usage: scripts/convex_dev <dev|agent|e2e|e2e-agent|e2e-built> [--reset] [--seed] [--watch] <command> [arguments...]"
role="${1:-}"
case "$role" in
  dev | agent | e2e | e2e-agent | e2e-built) ;;
  *) echo "$usage" >&2; exit 1 ;;
esac
# The role's web and backend ports in this checkout's lane, as scripts/convex_backend has them.
read -r web_port port _ <<< "$(node scripts/lanes.ts ports "$role")"
shift
reset=no
seed=no
watch=no
while [[ "${1:-}" == --* ]]; do
  case "$1" in
    --reset) reset=yes ;;
    --seed)  seed=yes ;;
    --watch) watch=yes ;;
    *) echo "$usage" >&2; exit 1 ;;
  esac
  shift
done
if [[ $# -lt 1 ]]; then echo "$usage" >&2; exit 1; fi

url="http://127.0.0.1:${port}"
datadir="data/convex-${role}"
convex=./node_modules/.bin/convex

children=()
stopChildren() {
  for pid in "${children[@]}"; do kill "$pid" 2> /dev/null || true; done
  wait 2> /dev/null || true
}
trap stopChildren EXIT
trap 'exit 143' INT TERM

answering() { curl --silent --fail --max-time 2 "${url}/version" > /dev/null; }

if ! answering; then
  mkdir -p "$datadir"
  scripts/convex_backend "$role" > "${datadir}/backend.log" 2>&1 &
  children+=("$!")
  for _ in $(seq 1 60); do
    answering && break
    sleep 1
  done
  if ! answering; then
    echo "The ${role} Convex backend did not answer at ${url}; its log:" >&2
    tail -n 20 "${datadir}/backend.log" >&2
    exit 1
  fi
fi

# A local role talks only to its own backend: a cloud deployment the environment names (a deploy
# key, say) would otherwise win over it.
unset CONVEX_DEPLOY_KEY CONVEX_DEPLOYMENT

# The CLI reads the backend's URL and admin key from these. cli.env is read line by line, never
# sourced: the admin key holds a "|".
while IFS='=' read -r envname val; do
  case "$envname" in
    CONVEX_SELF_HOSTED_URL | CONVEX_SELF_HOSTED_ADMIN_KEY) export "${envname}=${val}" ;;
  esac
done < "${datadir}/cli.env"

# Google's keys, from this environment (the Doppler config), or neither. Set before the push: the
# push is when the backend learns the HTTP routes Convex Auth adds for Google. The secret goes
# through a file only this user can read, removed at once, never a command line or the output.
googleKeys() {
  if [[ -n "${AUTH_GOOGLE_ID:-}" && -n "${AUTH_GOOGLE_SECRET:-}" ]]; then
    (
      keyfile="$(umask 077 && mktemp "${TMPDIR:-/tmp}/triquet-google-keys.XXXXXX")"
      trap 'rm -f "$keyfile"' EXIT
      printf 'AUTH_GOOGLE_ID=%s\nAUTH_GOOGLE_SECRET=%s\n' "$AUTH_GOOGLE_ID" "$AUTH_GOOGLE_SECRET" > "$keyfile"
      # Its output, and any failure's, is dropped whole: a refusal could quote the file it read
      if ! "$convex" env set --force --from-file "$keyfile" > /dev/null 2>&1; then
        echo "Could not give the ${role} backend Google's keys." >&2
        exit 1
      fi
    )
  else
    for envname in AUTH_GOOGLE_ID AUTH_GOOGLE_SECRET; do
      "$convex" env remove "$envname" > /dev/null 2>&1 || true
    done
  fi
}
googleKeys

push() { "$convex" dev --once --typecheck disable --tail-logs disable; }
if ! push; then
  if [[ "$reset" != yes ]]; then
    echo "The ${role} backend refused the push. If its rows no longer fit the schema, catch it up step by step (node scripts/deploy.ts --role ${role}), or empty it (--reset)." >&2
    exit 1
  fi
  echo "Emptying the ${role} backend, which --reset was going to do anyway, and pushing again." >&2
  scripts/convex_reset "$role"
  push
fi
"$convex" env set TRIQUET_CLEARABLE yes > /dev/null
# Every user an admin of a local backend (Actor.ofUser); production never sets it
"$convex" env set TRIQUET_EVERYONE_ADMIN yes > /dev/null
scripts/convex_auth_keys "$role"
if [[ "$reset" == yes ]]; then scripts/convex_reset "$role"; fi
# The step this backend now holds, in its migrations table (an empty backend fits any schema, so a
# reset backend holds HEAD), and its backfills started; scripts/deploy.ts finishes and records them.
step="$(node -e 'console.log(JSON.stringify({ sha: process.argv[1], subject: process.argv[2].split("\n")[0] || "(no subject)" }))' "$(git rev-parse HEAD)" "$(git log -1 --format=%s HEAD)")"
"$convex" run deploying:recordPushed "$step" > /dev/null
"$convex" run migrations:runAll > /dev/null
if [[ "$seed" == yes ]]; then "$convex" run seeding:seedWidgets > /dev/null; fi
if [[ "$watch" == yes ]]; then
  "$convex" dev --typecheck disable --tail-logs disable &
  children+=("$!")
fi

export NEXT_PUBLIC_CONVEX_URL="$url"
export PORT="$web_port"
"$@" &
children+=("$!")
wait "$!"
