#!/usr/bin/env bash
# Writes the Jazz migration a schema change needs: from the latest snapshot in
# src/db/migrations/snapshots (the schema the last migration led to) to src/db/schema.ts as it
# stands. Local files only: it asks no server. Run it again after any further schema change; with
# nothing new to migrate, it writes nothing. A running dev server applies what it writes to the
# local database.
#
# On a branch named by `pnpm run newb` (YYYYMMDD-label), the migration is named for the branch
# (…-20260926-initial_setup-<from>-<to>.ts) and what it wrote is staged in git. On any other
# branch it is left "unnamed" and unstaged.
#
# Guidance goes to stderr. Stdout carries one thing: the absolute path of the migration file it
# wrote, alone on a line, when it wrote one.
#
# Extra arguments pass through to `jazz-tools migrations create` (eg --fromHash <hash>).
# Reads TRIQUET_ENV.
# Usage: ./scripts/doppledo dev_mrflip ./scripts/jazz_migration
set -euo pipefail
cd "$(dirname "$0")/.."

if [[ ! "${TRIQUET_ENV:-}" =~ ^(dev|stg|prd)$ ]]; then
  echo "TRIQUET_ENV is \"${TRIQUET_ENV:-}\", not dev, stg or prd. Run this under Doppler: ./scripts/doppledo <stage>_<actor> ./scripts/jazz_migration" >&2
  exit 1
fi

migrations_dir="src/db/migrations"

# The migration sources and snapshots, one path per line
function migration_files() {
  find "$migrations_dir" -maxdepth 2 \( -name '*.ts' -o -name '*.json' \) -type f | sort
}

branch="$(git branch --show-current)"
named_branch=""
if [[ "$branch" =~ ^[0-9]{8}-[a-z](_?[a-z0-9])+$ ]]; then
  named_branch="$branch"
fi

mkdir -p "$migrations_dir"
before="$(migration_files)"
# Jazz's own "Next steps" name a bare `deploy`, not ours: its report stops short of them
pnpm --silent exec jazz-tools migrations create --schema-dir src/db --migrations-dir "$migrations_dir" \
  "$@" | sed '/^Next steps\{0,1\}:/,$d' >&2
written="$(comm -13 <(echo "$before") <(migration_files))"
migration="$(echo "$written" | grep '\.ts$' || true)"

echo >&2
if [[ -z "$written" ]]; then
  echo "Nothing written: the schema is the one the latest snapshot holds, so there is nothing to migrate." >&2
  exit 0
fi

# Named here rather than by Jazz's --name, which would turn the branch's underscores into dashes
if [[ -n "$named_branch" && "$migration" == *-unnamed-* ]]; then
  renamed="${migration/-unnamed-/-${named_branch}-}"
  mv "$migration" "$renamed"
  written="${written/$migration/$renamed}"
  migration="$renamed"
fi

if [[ -n "$named_branch" ]]; then
  echo "$written" | xargs git add --
  echo "Staged in git:" >&2
else
  echo "Not staged: on branch \"$branch\", not one made by \`pnpm run newb\`. Wrote:" >&2
fi
echo "$written" | sed 's/^/  /' >&2
echo >&2

if [[ -z "$migration" ]]; then
  echo "No migration file needed: this change transforms no rows. The snapshot records the new schema; commit it." >&2
  exit 0
fi

if [[ "$migration" == *-unnamed-* ]]; then
  echo "Rename the migration: replace \"unnamed\" with what the change is, keeping the timestamp and both hashes." >&2
fi
if grep -q 'TODO' "$migration"; then
  echo "The migration needs editing. In its migrate section, resolve every TODO: a default for each" >&2
  echo "new required column (what existing rows read as), a backwardsDefault for each removed one (what" >&2
  echo "older clients see), s.renameFrom('old_name') for a rename. \"No safe migration steps were" >&2
  echo "inferred\" means Jazz cannot translate the change on its own: ask a Coach. Then git add it:" >&2
else
  echo "The migration needs no edits: Jazz inferred every step. Read its migrate section, if it has one," >&2
  echo "to confirm the defaults, and commit it:" >&2
fi
echo "$(pwd)/$migration"
