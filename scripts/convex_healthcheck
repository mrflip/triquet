#!/usr/bin/env bash
# Asks a Convex deployment two things and changes nothing in it: does it answer, and does it hold
# this checkout's functions? The second compares the deployment's function spec (`convex
# function-spec`: every function's path, kind, visibility and argument shape, which the schema
# shapes through the row validators) with the spec of a local role that this checkout is pushed to
# first (scripts/convex_dev). Equal specs mean the deployment serves what convex/ says.
#
#   scripts/convex_healthcheck agent                  a local role, from its data/convex-agent/cli.env
#   scripts/convex_healthcheck --cloud [--via dev]    the deployment CONVEX_DEPLOY_KEY names, which
#                                                     only a janitor config holds; the checkout is
#                                                     pushed to the local role --via names (dev)
#
#   ./scripts/doppledo prd_janitor ./scripts/convex_healthcheck --cloud
#
# The local role being checked, or the one --via names, is pushed to as part of the check; that is
# the only write, and it is what pnpm dev would do anyway. Exits 1 when the deployment does not
# answer or its functions differ.
#
# Usage: scripts/convex_healthcheck <dev|agent|e2e|e2e-agent> | --cloud [--via <role>]
set -euo pipefail
cd "$(dirname "$0")/.."

usage="Usage: scripts/convex_healthcheck <dev|agent|e2e|e2e-agent> | --cloud [--via <role>]"
convex=./node_modules/.bin/convex
scratch="$(mktemp -d "${TMPDIR:-/tmp}/triquet-healthcheck.XXXXXX")"
trap 'rm -rf "$scratch"' EXIT

# The spec of the deployment the environment names, as JSON with its URL left out, so two
# deployments' specs compare equal when they hold the same functions.
specOf() {
  "$convex" function-spec > "$scratch/$1.raw.json"
  node -e '
    const fs = require("fs")
    const spec = JSON.parse(fs.readFileSync(process.argv[1], "utf8"))
    const functions = spec.functions.sort((aa, bb) => aa.identifier.localeCompare(bb.identifier))
    fs.writeFileSync(process.argv[2], JSON.stringify(functions, null, 2) + "\n")
  ' "$scratch/$1.raw.json" "$scratch/$1.json"
}

# Point the CLI at a local role's backend: its cli.env, read line by line, never sourced (the
# admin key holds a "|"), and no cloud deployment the environment names.
useLocal() {
  local role="$1" clienv="data/convex-$1/cli.env"
  if [[ ! -s "$clienv" ]]; then
    echo "No ${clienv}: start the ${role} backend first (scripts/convex_backend ${role})." >&2
    exit 1
  fi
  unset CONVEX_DEPLOY_KEY CONVEX_DEPLOYMENT
  while IFS='=' read -r envname val; do
    case "$envname" in
      CONVEX_SELF_HOSTED_URL | CONVEX_SELF_HOSTED_ADMIN_KEY) export "${envname}=${val}" ;;
    esac
  done < "$clienv"
  if [[ ! "${CONVEX_SELF_HOSTED_URL:-}" =~ ^http://127\.0\.0\.1:[0-9]+$ ]]; then
    echo "${clienv} names ${CONVEX_SELF_HOSTED_URL:-no backend}, not a local one: refusing." >&2
    exit 1
  fi
}

answering() { curl --silent --fail --max-time 5 "$1/version" > /dev/null; }

target="${1:-}"
case "$target" in
  dev | agent | e2e | e2e-agent)
    useLocal "$target"
    if ! answering "$CONVEX_SELF_HOSTED_URL"; then
      echo "The ${target} backend does not answer at ${CONVEX_SELF_HOSTED_URL}." >&2
      exit 1
    fi
    echo "The ${target} backend answers at ${CONVEX_SELF_HOSTED_URL}."
    specOf before
    "$convex" dev --once --typecheck disable --tail-logs disable > /dev/null
    specOf after
    if diff -u "$scratch/before.json" "$scratch/after.json" > "$scratch/diff"; then
      echo "It held this checkout's functions already ($(node -e 'console.log(require(process.argv[1]).length)' "$scratch/after.json") of them); pushing changed nothing."
    else
      echo "It did not hold this checkout's functions; pushing changed:"
      cat "$scratch/diff"
      exit 1
    fi
    ;;
  --cloud)
    via=dev
    if [[ "${2:-}" == --via ]]; then via="${3:?$usage}"; fi
    case "$via" in dev | agent | e2e | e2e-agent) ;; *) echo "$usage" >&2; exit 1 ;; esac
    if [[ -z "${CONVEX_DEPLOY_KEY:-}" ]]; then
      echo "CONVEX_DEPLOY_KEY is not set: run under a janitor config (scripts/doppledo prd_janitor ...)." >&2
      exit 1
    fi
    cloudkey="$CONVEX_DEPLOY_KEY"
    unset CONVEX_SELF_HOSTED_URL CONVEX_SELF_HOSTED_ADMIN_KEY
    if ! specOf cloud; then
      echo "The deployment CONVEX_DEPLOY_KEY names did not answer function-spec." >&2
      exit 1
    fi
    echo "The deployment answers: $(node -e 'console.log(JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")).url)' "$scratch/cloud.raw.json")"
    # This checkout, pushed to the local role, is what the deployment is compared with.
    scripts/convex_dev "$via" true > /dev/null
    (useLocal "$via"; specOf local)
    export CONVEX_DEPLOY_KEY="$cloudkey"
    if diff -u "$scratch/cloud.json" "$scratch/local.json" > "$scratch/diff"; then
      echo "It holds this checkout's functions ($(node -e 'console.log(require(process.argv[1]).length)' "$scratch/local.json") of them)."
    else
      echo "Its functions differ from this checkout's (- the deployment, + this checkout):"
      cat "$scratch/diff"
      exit 1
    fi
    ;;
  *)
    echo "$usage" >&2
    exit 1
    ;;
esac
