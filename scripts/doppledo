#!/usr/bin/env bash
set -euo pipefail
# Runs a command under a Doppler config, first printing (to stderr) the config and the command.
# Usage: ./scripts/doppledo <${stage}_${actor}> <command> [arguments...]

usage='Usage: ./scripts/doppledo <${stage}_${actor}> <command> [arguments...], eg ./scripts/doppledo prd_janitor ./scripts/jazz_healthcheck'

# exit unless there is a doppler config and a command to run
if [[ $# -lt 2 ]]; then
  echo "$usage" >&2
  exit 1
fi
stage_actor="$1"
shift

if [[ ! "$stage_actor" =~ ^[a-z]+_[a-z0-9]+$ ]]; then
  echo "Invalid stage_actor: \"$stage_actor\" -- should be in the form <stage>_<actor>, eg prd_janitor or dev_e2e" >&2
  exit 1
fi
echo "Running as $stage_actor: $*" >&2
exec doppler run --config "$stage_actor" -- "$@"
