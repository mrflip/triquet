{
  "name": "triquet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "engines": {
    "node": "24.x"
  },
  "imports": {
    "#inspect-env": {
      "node": "./src/lib/inspectify-node.ts",
      "default": "./src/lib/inspectify-browser.ts"
    }
  },
  "pnpm": {
    "allowedBuildScripts": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "doppler run -- scripts/convex_dev dev --seed --watch next dev",
    "dev:agent": "scripts/doppledo dev_claude scripts/convex_dev agent --seed --watch next dev",
    "dev:agent:botkey": "scripts/doppledo dev_claude cross-env ENABLE_ANTHROPIC_BOT=allow scripts/convex_dev agent --seed --watch next dev",
    "build": "next build",
    "build:agent": "scripts/doppledo dev_claude scripts/as_role agent-built cross-env NEXT_DIST_DIR=.next-agent-build next build",
    "build:vercel": "convex deploy --cmd 'node scripts/convex-previews.ts after-vercel-build && pnpm run build' --preview-run migrations:runAll && node scripts/convex-migrations.ts after-vercel-build",
    "start": "next start",
    "start:agent": "scripts/doppledo dev_claude scripts/as_role agent-built cross-env NEXT_DIST_DIR=.next-agent-build next start",
    "lint": "eslint --cache --cache-strategy content --cache-location .eslintcache .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bid": "vitest run --testTimeout=60000",
    "test:e2e": "scripts/doppledo dev_e2e scripts/as_role e2e env NEXT_DIST_DIR=.next-e2e playwright test",
    "test:e2e:agent": "scripts/doppledo dev_e2e scripts/as_role e2e-agent env NEXT_DIST_DIR=.next-e2e-agent playwright test",
    "test:e2e:built": "scripts/doppledo dev_e2e scripts/as_role e2e-built env NEXT_DIST_DIR=.next-e2e-built TRIQUET_E2E_SERVER=built playwright test",
    "convex:backend": "scripts/convex_backend",
    "convex:reset": "scripts/convex_reset",
    "previews": "scripts/doppledo dev_aijanitor scripts/convex_preview node scripts/convex-previews.ts",
    "sessions": "node scripts/session-branches.ts",
    "newb": "scripts/newb",
    "lane": "node scripts/lanes.ts lane",
    "worktree": "node scripts/spine.ts worktree",
    "catchup": "node scripts/spine.ts catchup",
    "justify": "node scripts/spine.ts justify",
    "e2e": "node scripts/spine.ts e2e",
    "e2e:rerun": "node scripts/spine.ts e2e --last-failed --workers=1",
    "e2e:log": "node scripts/spine.ts e2e-log",
    "e2e:smoke": "node scripts/spine.ts e2e --grep @smoke",
    "land": "node scripts/spine.ts land",
    "sweep": "node scripts/spine.ts sweep",
    "restack": "node scripts/spine.ts restack",
    "automerge": "tsx scripts/automerge.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@atlaskit/pragmatic-drag-and-drop": "^3.1.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^2.2.2",
    "@auth/core": "0.41.1",
    "@convex-dev/auth": "0.0.96",
    "@convex-dev/migrations": "0.3.6",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/work-sans": "^5.3.0",
    "@fontsource/zilla-slab": "^5.3.0",
    "@isomorphic-git/lightning-fs": "^4.8.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/material-nextjs": "^9.4.0",
    "@next/mdx": "^16.3.6",
    "clsx": "^2.1.1",
    "convex": "1.46.0",
    "convex-helpers": "0.1.124",
    "d3-array": "^3.2.4",
    "es-toolkit": "^1.52.0",
    "fflate": "^0.8.3",
    "isomorphic-git": "^1.42.2",
    "jsonata": "1.8.9",
    "liquidjs": "10.30.0",
    "mdast-util-definitions": "^6.0.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm-autolink-literal": "^2.0.1",
    "mdast-util-gfm-strikethrough": "^2.0.1",
    "mdast-util-to-string": "^4.0.0",
    "micromark-extension-gfm-autolink-literal": "^2.1.0",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-util-sanitize-uri": "^2.0.1",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-number-format": "^5.4.5",
    "recharts": "^3.10.1",
    "recheck": "^4.5.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "safe-stable-stringify": "^2.5.0",
    "unique-names-generator": "^4.7.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/d3-array": "^3.2.2",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "convex-test": "0.0.60",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-chai-expect": "^4.1.0",
    "eslint-plugin-chai-friendly": "^1.2.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-sonarjs": "^4.2.1",
    "eslint-plugin-unicorn": "^75.0.0",
    "proper-lockfile": "4.1.2",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
