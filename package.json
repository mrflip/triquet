{
  "name": "triquet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "engines": {
    "node": "24.x"
  },
  "imports": {
    "#inspect-env": {
      "node": "./src/lib/inspectify-node.ts",
      "default": "./src/lib/inspectify-browser.ts"
    }
  },
  "pnpm": {
    "allowedBuildScripts": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "doppler run -- scripts/convex_dev dev --watch next dev",
    "dev:agent": "scripts/doppledo dev_claude scripts/convex_dev agent --watch next dev",
    "build": "next build",
    "build:agent": "scripts/doppledo dev_claude cross-env NEXT_DIST_DIR=.next-agent-build next build",
    "build:vercel": "convex deploy --cmd 'pnpm run build'",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "scripts/doppledo dev_e2e playwright test",
    "test:e2e:agent": "scripts/doppledo dev_e2e env PORT=3003 CONVEX_ROLE=e2e-agent NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3403 NEXT_DIST_DIR=.next-e2e-agent playwright test",
    "convex:backend": "scripts/convex_backend",
    "convex:reset": "scripts/convex_reset",
    "newb": "scripts/newb"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@atlaskit/pragmatic-drag-and-drop": "^3.1.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^2.2.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@isomorphic-git/lightning-fs": "^4.8.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/material-nextjs": "^9.4.0",
    "@next/mdx": "^16.3.6",
    "clsx": "^2.1.1",
    "convex": "1.46.0",
    "convex-helpers": "0.1.124",
    "es-toolkit": "^1.52.0",
    "fflate": "^0.8.3",
    "isomorphic-git": "^1.42.2",
    "jsonata": "1.8.9",
    "next": "^16.3.5",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "safe-stable-stringify": "^2.5.0",
    "unique-names-generator": "^4.7.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "convex-test": "0.0.60",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-sonarjs": "^4.2.1",
    "eslint-plugin-unicorn": "^75.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
